    <string name="life_pulse_info_how_it_works_title">How does this measurement work?</string>
    <string name="life_pulse_info_how_it_works_body">The camera and flash detect blood volume changes in your fingertip (PPG) and estimate pulse.</string>
    <string name="life_pulse_info_best_results_title">Best-result steps</string>
    <string name="life_pulse_info_step1">1) Fully cover rear camera and flash with your fingertip.</string>
    <string name="life_pulse_info_step2">2) Use light contact, do not press too hard.</string>
    <string name="life_pulse_info_step3">3) Keep phone steady, do not talk/move.</string>
    <string name="life_pulse_info_step4">4) Wait 25–35 seconds.</string>
    <string name="life_pulse_info_step5">5) Warm your hands first if they are cold.</string>
    <string name="life_pulse_info_fail_title">When can measurement fail?</string>
    <string name="life_pulse_info_fail_body">Motion, cold hands, low light, or missing flash support can degrade measurement.</string>
