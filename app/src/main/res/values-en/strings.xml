    <string name="life_pulse_info_step2">2) Use light contact, do not press too hard.</string>
    <string name="life_pulse_info_step3">3) Keep phone steady, do not talk/move.</string>
    <string name="life_pulse_info_step4">4) Wait 25–35 seconds.</string>
    <string name="life_pulse_info_step5">5) Warm your hands first if they are cold.</string>
